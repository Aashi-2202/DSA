class Solution {
  public:
    vector<int> calculateSpan(vector<int>& arr) {
        
        stack<pair<int,int>> st;
        vector<int> ans;
        
        for(int i = 0; i < arr.size(); i++)
        {
            if(st.empty())
            {
                ans.push_back(i + 1);
            }
            else if(!st.empty() && st.top().second > arr[i])
            {
                ans.push_back(i - st.top().first);
            }
            else if(!st.empty() && st.top().second <= arr[i])
            {
                while(!st.empty() && st.top().second <= arr[i])
                {
                    st.pop();
                }
                
                if(st.empty())
                {
                    ans.push_back(i + 1);
                }
                else
                {
                    ans.push_back(i - st.top().first);
                }
            }
            
            st.push({i, arr[i]});
        }
        
        return ans;
    }
};
