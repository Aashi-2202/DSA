/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    bool isPalindrome(ListNode* head) {

        if(head == nullptr || head->next == nullptr) return true;

        ListNode* slow = head;
        ListNode* fast = head;
        
        while(fast!=nullptr && fast->next!=nullptr){   //mid element
            slow = slow->next;
            fast = fast->next->next;
        }

        if(fast!=nullptr && fast->next==NULL){
            slow = slow->next;
        }

        ListNode* prev = NULL;

        while(slow!=nullptr && slow->next!=nullptr){
            ListNode* temp = slow->next;
            slow->next =prev;
            prev = slow;
            slow=temp;
        }

        if(slow != nullptr){
            slow->next =prev;
        }

        fast =head;

        while(slow && fast){
            if(slow->val != fast->val){
                return false;
                break;
            }

            slow=slow->next;
            fast=fast->next;
        }
        return true;
    }
};
