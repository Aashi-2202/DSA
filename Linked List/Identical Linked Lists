/* Strucutre of a Node in linked list
class Node {
public:
    int data;
    Node* next;

    Node(int x) {
        data = x;
        next = nullptr;
    }
}; */
class Solution {
  public:
    bool areIdentical(Node *head1, Node *head2) {
        // code here
        
        Node* curr1 = head1;
        Node* curr2 = head2;
        
        if(head1 == nullptr && head2 == nullptr){
            return true;
        }
        else if(head1 == nullptr || head2 == nullptr){
            return false;
        }
        
        while(curr1 != nullptr && curr2 != nullptr && curr1->data == curr2->data){
            
            if(curr1->next==nullptr && curr2->next==nullptr){
                return true;
                break;
            }
            
            curr1 = curr1->next;
            curr2 = curr2->next;
            
        }
        
        return false;
        
    }
};
