class Solution {
public:
    vector<int> partitionLabels(string s) {

        unordered_map <char,int>mp;

        for(int i=s.size()-1; i>=0; i--) //entering last occurance
        {
            if(!mp.count(s[i])) //add elements if they already dont exist
            {
                mp[s[i]]=i;
            }
        }

        vector<int> ans;
        int i=0;

        while(i<s.size())
        {
            int last_occur = mp[s[i]];

            for(int j=i+1; j<=last_occur; j++)
            {
                if(mp[s[i]] < mp[s[j]])
                {
                    last_occur = max(last_occur, mp[s[j]]);
                }
            }

            int length = last_occur - i +1;

            ans.push_back(length); 

            i = last_occur+1;
        }

        return ans;
        
    }
};
