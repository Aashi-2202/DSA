class Solution {
public:
    int shipWithinDays(vector<int>& weights, int days) {

        
        int start, end;
        
        int mid, ans;
        
        for(int i=0; i<weights.size(); i++)
        {
            start = max(start, weights[i]);
            
            end += weights[i];
        }
        
        while(start<=end)
        {
            mid = start + (end-start)/2;
            
            int board = 0;
            int count = 1;
            
            for(int i=0; i<weights.size(); i++)
            {
                board += weights[i];
                
                if(board>mid)
                {
                    count++;
                    
                    board = weights[i];
                }
                
            }
            
            if(count <= days)
            {
                ans = mid;
                end = mid-1;
            }
            
            else 
            {
                start = mid+1;
            }
        }
        
        return ans;
        
    }
};
