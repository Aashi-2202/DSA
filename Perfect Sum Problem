class Solution {
  public:
    int perfectSum(vector<int>& arr, int target) {
        // code here
        int n=arr.size();
        
        vector<vector<int>>dp(n+1,vector<int>(target+1, -1));
        
        for(int i=0; i<=target; i++){
            dp[0][i] = true;
        }
        
        for(int i=0; i<=n; i++){
            dp[i][0] = false;
        }
        
        
        return Solve(arr,target,n,dp);
    }
    
    int Solve(vector<int>& arr, int target, int n, vector<vector<int>>& dp){
        
        if(target == 0) return 1;
        
        if(n == 0) return 0;
        
        if(dp[n][target] != -1) return dp[n][target]; 
        
        if(arr[n-1]<=target){
            
            return dp[n][target] = (Solve(arr,target-arr[n-1],n-1, dp) + Solve(arr,target,n-1, dp));
        }
        
        else{
            return dp[n][target] = Solve(arr,target,n-1,dp);
        }
    }
};
