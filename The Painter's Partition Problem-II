class Solution {
  public:
    int minTime(vector<int>& arr, int k) {
        // code here
        
        if(arr.size()<k){
            return -1;
        }
        
        int start, end;
        
        int mid, ans;
        
        for(int i=0; i<arr.size(); i++)
        {
            start = max(start, arr[i]);
            
            end += arr[i];
        }
        
        while(start<=end)
        {
            mid = start + (end-start)/2;
            
            int board = 0;
            int count = 1;
            
            for(int i=0; i<arr.size(); i++)
            {
                board += arr[i];
                
                if(board>mid)
                {
                    count++;
                    
                    board = arr[i];
                }
                
            }
            
            if(count <= k)
            {
                ans = mid;
                end = mid-1;
            }
            
            else 
            {
                start = mid+1;
            }
        }
        
        return ans;
    }
};
