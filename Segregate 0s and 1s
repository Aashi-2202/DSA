class Solution {
  public:
    void segregate0and1(vector<int> &arr) {
        // code here
        
        int start = 0;
        
        int end = arr.size()-1;
        
        while(start<=end)
        {
            if(arr[start]==1 && arr[end]==0)
            {
                arr[start] = 0;
                arr[end] = 1;
                
                start++;
                end--;
            }
            else if(arr[start]==0){
                start++;
            }
            else if(arr[end]==1){
                end--;
            }
            else if(arr[start]==0 && arr[end]==1){
                start++;
                end--;
            }
        }
    }
};
