class Solution {
public:
    int mostWordsFound(vector<string>& sentences) {
        
        int max_count = 0;
        
        for(string s : sentences) {
            
            int count = 1;  
            
            for(char c : s) {
                if(c == ' ')
                    count++;
            }
            
            max_count = max(max_count, count);
        }
        
        return max_count;
    }
};
