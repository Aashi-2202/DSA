class Solution {
  public:
    int findMin(int n) {
        // code here
        
        vector<int> currency = {10,5,2,1};
        
        int i=0;
        int count = 0;
        
        while(n>0)
        {
            if(currency[i] <= n )
            {
                n = n-currency[i];
                count++;
            }
            else
            {
                i++;
            }
        }
        
        return count;
    }
};
