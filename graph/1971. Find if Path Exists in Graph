class Solution {
public:
    bool validPath(int n, vector<vector<int>>& edges, int source,int destination) {

        unordered_map<int, vector<int>> umap;
        for (auto x : edges) {
            vector<int> temp = x;             // acquired [0,1]
            umap[temp[0]].push_back(temp[1]); // [0->1]
            umap[temp[1]].push_back(temp[0]); //[1->0]
        }

        vector<bool> visited(n, false);
        queue<int> q;

        q.push(source);
        visited[source] = true;

        while (!q.empty()) {
            int u = q.front();
            q.pop();

            vector<int> temp = umap[u]; // taking the vector of neighbours
            for (int i = 0; i < temp.size(); i++) { // traversal of vector 
                int vertex = temp[i];
                if (visited[vertex] == false) {
                    q.push(vertex);
                    visited[vertex] = true;
                }
            }
        }

        return visited[destination];
    }
};
