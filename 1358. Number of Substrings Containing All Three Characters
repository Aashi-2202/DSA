class Solution {
public:
    int numberOfSubstrings(string s) {
        vector<int> ans(3);
        int i=0, j=0, count=0, n=s.size();

        if(n<3) return 0;

        while(j<n){
            ans[s.at(j)-'a']++;

            while(ans[0]>=1 && ans[1]>=1 && ans[2]>=1){
                count+=n-j;
                ans[s.at(i)-'a']--;
                i++;
            }
            j++;
        }
        return count;
    }
};
