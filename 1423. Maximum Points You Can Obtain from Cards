class Solution {
public:
    int maxScore(vector<int>& cardPoints, int k) {
        
        int leftSum = 0;
        int rightSum = 0;
        int maxSum = 0;
        int i =0, j=0, n=cardPoints.size();

        for(int i = 0; i<k; i++)
        {
            leftSum += cardPoints[i];
        }
        maxSum = max(leftSum,maxSum);

        for(int i=0; i<k; i++)
        {
            leftSum += cardPoints[n-i-1];
            rightSum -= cardPoints[k-i-1];
            maxSum = max(leftSum+rightSum, maxSum);
        }
        return maxSum;
    }
};
