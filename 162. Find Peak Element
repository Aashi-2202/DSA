class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int low = 0;
        int high = nums.size() - 1;

        if (low==high){
            return low;
        } 
        else if(nums[0]>nums[1]){
            return 0;
        } 
        else if(nums[high]>nums[high-1]){
            return high;
        }
        for(int i=1; i<high; i++){
            if(nums[i]>nums[i-1] && nums[i]>nums[i+1]){
                return i;
            }
        }
        return -1;
    }
};
