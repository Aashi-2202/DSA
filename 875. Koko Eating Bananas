class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        
        int n = piles.size();

        sort(piles.begin(), piles.end());

        int start = 1;

        int end = piles[n-1],ans=end;

        while(start<=end)
        {
            int mid = start + (end-start)/2;

            long long count=0;

            for(int i=0; i<n; i++)
            {
                if(piles[i]%mid == 0)
                {
                    count += piles[i]/mid;
                }
                else if(piles[i]%mid != 0)
                {
                    count += piles[i]/mid;
                    count++;
                    
                }
                
            }

            if(count <= h)
            {
                ans = mid;
                end = mid - 1;
            }
            else
            {
                start = mid+1;
            }
        }

        return ans;
    }
};
